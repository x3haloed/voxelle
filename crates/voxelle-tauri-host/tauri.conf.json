{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxelle",
  "version": "0.1.0",
  "identifier": "chat.voxelle.desktop",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Voxelle",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Private peer-to-peer spaces, chat, and calls.",
    "longDescription": "Voxelle is a native peer-to-peer communication workbench for small private communities.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
